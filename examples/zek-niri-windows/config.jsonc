// ZEK-niri 主题（Windows 适配版）
// 原配置：https://github.com/sky1234762/ZEK-niri/tree/main/configs/waybar
//
// 结构与原版一致：左（工作区 + 当前窗口）/ 中（10 项，Win11 徽标居中）/ 右（后台任务、亮度、音量、蓝牙、网络、电量、通知、重启 waybar）
// Windows 替换：niri/workspaces -> workspaces（1..3 虚拟桌面按钮）、niri/window -> sway/window、
// tray -> 后台任务菜单、bluetooth/cava -> 原生 Windows 实现、Linux 命令 -> Windows 等价命令。
{
    "layer": "top",
    "position": "top",
    "fixed-center": true,
    "height": 20,
    "fullscreen-behavior": "cover",
    "reload_style_on_change": false,
    "include": [
        "modules.jsonc",
        "modules-dividers.jsonc"
    ],
    "modules-left": [
        "workspaces",
        "custom/right_div_5",
        "sway/window",
        "custom/right_div_6"
    ],
    "modules-center": [
        "custom/spacer",
        "custom/left_div_3",
        "custom/colors-theme",
        "custom/actions",
        "custom/wallpapers",
        "custom/screenshot",
        "custom/clipboard",
        "custom/left_div_2",
        "idle_inhibitor",
        "clock#date",
        "power-profiles-daemon",
        "custom/left_div_11",
        "custom/left_div_1",
        "custom/applauncher",
        "custom/right_div_1",
        "custom/right_div_11",
        "clock",
        "custom/right_div_2",
        "custom/cava",
        "custom/right_div_3"
    ],
    "modules-right": [
        "custom/left_div_7",
        "tray",
        "custom/left_div_4",
        "backlight",
        "custom/left_div_8",
        "pulseaudio",
        "bluetooth",
        "network",
        "battery",
        "custom/left_div_5",
        "custom/swaync",
        "group/powermenu"
    ]
}
