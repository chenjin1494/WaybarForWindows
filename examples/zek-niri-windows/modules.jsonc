{
    "battery": {
        "interval": 60,
        "states": { "critical": 20 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}% ",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂂", "󰁹"],
        "tooltip-format": "剩余电量：{capacity}%\n---\n左键：打开电源设置",
        "on-click": "cmd /c start ms-settings:batterysaver"
    },
    "clock": {
        "interval": 60,
        "format": "󰥔 {:%H:%M}",
        "tooltip-format": "{:%Y/%m/%d %A}\n---\n左键：打开日历\n右键：打开设置",
        "max-length": 25,
        "on-click": "cmd /c start outlookcal:",
        "on-click-right": "cmd /c start ms-settings:"
    },
    "clock#date": {
        "format": "󰸗",
        "tooltip-format": "{:%Y/%m/%d %A}",
        "on-click": "cmd /c start outlookcal:"
    },
    "workspaces": {
        "count": 3
    },
    "tray": {
        "format": "\uF00A"
    },
    "sway/window": {
        "format": "{title}",
        "max-length": 40,
        "tooltip-format": "{title}\n{app_id}",
        "rewrite": {
            "(.*) - Mozilla Firefox": "🌎 $1",
            "(.*) - Microsoft Edge": "🌐 $1"
        }
    },
    "network": {
        "format-disconnected": "{icon}",
        "format-wifi": "{icon}",
        "format-ethernet": "{icon}",
        "format-icons": {"disconnected": "\uF00D", "wifi": ["\uF1EB", "\uF1EB", "\uF1EB", "\uF1EB", "\uF1EB"], "ethernet": "\uF0AC"},
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname} : {ipaddr}\n---\n左键：打开网络设置",
        "tooltip-format-ethernet": "{ifname} : {ipaddr}\n---\n左键：打开网络设置",
        "tooltip-format-disconnected": "网络未连接\n---\n左键：打开网络设置",
        "on-click": "cmd /c start ms-settings:network"
    },
    "bluetooth": {
        "format-disabled": "󰂲",
        "tooltip-format-disabled": "未检测到蓝牙硬件\n---\n左键：打开蓝牙设置",
        "format": "󰂯",
        "tooltip-format-on": "左键：打开蓝牙设置\n右键：切换蓝牙",
        "on-click-right": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%LOCALAPPDATA%\\Programs\\Waybar\\config\\scripts\\toggle-bluetooth.ps1\"",
        "on-click": "cmd /c start ms-settings:bluetooth"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "当前性能模式：{profile}\n---\n左键：切换性能模式",
        "tooltip": true,
        "format-icons": {
            "performance": "󱐋",
            "balanced": "",
            "power-saver": "󰾆"
        }
    },
    "custom/screenshot": {
        "format": "",
        "tooltip-format": "左键：区域截图\n中键：全屏截图\n右键：截图工具",
        "on-click": "cmd /c start ms-screenclip:",
        "on-click-middle": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%LOCALAPPDATA%\\Programs\\Waybar\\config\\scripts\\screenshot-fullscreen.ps1\"",
        "on-click-right": "cmd /c start snippingtool.exe"
    },
    "group/audio": {
        "orientation": "inherit",
        "drawer": { "transition-left-to-right": false },
        "modules": ["pulseaudio", "pulseaudio/slider"]
    },
    "pulseaudio": {
        "tooltip-format": "左键：静音\n右键：关闭麦克风\n滚轮：调节音量",
        "format": "{icon} {format_source} ",
        "format-source": "󰍬{volume}%",
        "format-source-muted": "󰍭",
        "format-muted": "󰖁 {format_source} ",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋋",
            "bluetooth": "󰋋",
            "speaker": ["󰕿", "󰖀", "󰕾"]
        }
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },
    "custom/applauncher": {
        "tooltip-format": "左键：打开开始菜单\n右键：打开设置",
        "format": "\uF17A",
        "on-click": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%LOCALAPPDATA%\\Programs\\Waybar\\config\\scripts\\open-start.ps1\"",
        "on-click-right": "cmd /c start ms-settings:"
    },
    "group/powermenu": {
        "orientation": "inherit",
        "drawer": { "transition-left-to-right": false },
        "modules": ["custom/wlogout"]
    },
    "custom/wlogout": {
        "tooltip-format": "左键：重启 waybar（重新加载配置）\n右键：电源设置",
        "format": "󰐥",
        "on-click": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%LOCALAPPDATA%\\Programs\\Waybar\\config\\scripts\\restart-waybar.ps1\"",
        "on-click-right": "cmd /c start ms-settings:powersleep",
        "on-scroll-up": "true",
        "on-scroll-down": "true"
    },
    "backlight/slider": {
        "min": 5,
        "max": 100,
        "orientation": "horizontal"
    },
    "backlight": {
        "tooltip": true,
        "tooltip-format": "调节屏幕亮度（滚轮）",
        "format": "{icon}",
        "format-icons": ["\uF185", "\uF185", "\uF185", "\uF185", "\uF185", "\uF185", "\uF185", "\uF185", "\uF185"]
    },
    "group/ddcutil": {
        "orientation": "inherit",
        "drawer": { "transition-left-to-right": false },
        "modules": ["backlight", "backlight/slider"]
    },
    "custom/swaync": {
        "tooltip": false,
        "format": "󰂚",
        "on-click": "cmd /c start ms-settings:notifications"
    },
    "internal/power": {
        "format": "{icon}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂂", "󰁹"]
    },
    "custom/actions": {
        "format": "󰆍",
        "tooltip-format": "左键：Windows Terminal (PowerShell)\n右键：cmd",
        "on-click": "cmd /c start \"\" wt.exe -p \"Windows PowerShell\"",
        "on-click-right": "cmd /c start \"\" cmd.exe"
    },
    "custom/colors-theme": {
        "format": "{}",
        "return-type": "json",
        "exec": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%LOCALAPPDATA%\\Programs\\Waybar\\config\\scripts\\toggle-colors.ps1\" status",
        "tooltip": true,
        "on-click": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%LOCALAPPDATA%\\Programs\\Waybar\\config\\scripts\\toggle-colors.ps1\" toggle"
    },
    "custom/clipboard": {
        "format": "󰅍",
        "on-click": "cmd /c start ms-settings:clipboard",
        "on-click-right": "cmd /c echo off | clip",
        "tooltip-format": "左键：打开剪贴板历史\n右键：清除剪贴板历史"
    },
    "custom/wallpapers": {
        "format": "󰸉",
        "tooltip-format": "左键：打开壁纸设置\n右键：打开个性化",
        "on-click": "cmd /c start ms-settings:personalization-background",
        "on-click-right": "cmd /c start ms-settings:personalization"
    },
    "custom/cava": {
        "bars": 18,
        "framerate": 40
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰈈",
            "deactivated": "󰈉"
        },
        "start-activated": true,
        "tooltip-format-activated": "自动熄屏已禁止",
        "tooltip-format-deactivated": "自动熄屏已开启"
    },
	/* 居中占位：让中心组徽标左右等长 */
	"custom/spacer": {
		"width": 47
	}
}