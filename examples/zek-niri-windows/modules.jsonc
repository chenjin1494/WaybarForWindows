{
    "battery":  {
                    "interval":  60,
                    "states":  {
                                   "critical":  20
                               },
                    "format":  "{icon} {capacity}%",
                    "format-charging":  "󰂄 {capacity}% ",
                    "format-icons":  [
                                         "󰂎",
                                         "󰁺",
                                         "󰁻",
                                         "󰁼",
                                         "󰁽",
                                         "󰁾",
                                         "󰁿",
                                         "󰂀",
                                         "󰂂",
                                         "󰁹"
                                     ],
                    "tooltip-format":  "剩余电量：{capacity}%\n充 放 电 ：{power}\n可用时间：{timeTo}\n---\n电池健康度：{health}%\n---\n左键：打开电源面板",
                    "on-click":  "cmd /c start ms-settings:batterysaver"
                },
    "clock":  {
                  "interval":  60,
                  "format":  "󰥔 {:%H:%M}",
                  "tooltip-format":  "{:%Y/%m/%d %A}\n---\n左键：打开日历\n右键：打开设置",
                  "max-length":  25
              },
    "clock#date":  {
                       "format":  "󰸗",
                       "tooltip-format":  "{:%Y/%m/%d %A}"
                   },
    "network":  {
                    "format-disconnected":  "{icon}",
                    "format-wifi":  "{icon}",
                    "format-ethernet":  "{icon}",
                    "format-icons":  {
                                         "disconnected":  "󰤮",
                                         "wifi":  [
                                                      "󰤯",
                                                      "󰤟",
                                                      "󰤢",
                                                      "󰤥",
                                                      "󰤨"
                                                  ],
                                         "ethernet":  "󰈀"
                                     },
                    "tooltip-format-wifi":  "{essid} ({signalStrength}%)\n{ifname} : {ipaddr}\n---\n左键：打开网络设置",
                    "tooltip-format-ethernet":  "{ifname} : {ipaddr}\n---\n左键：打开网络设置",
                    "tooltip-format-disconnected":  "网络未连接\n---\n左键：打开网络设置",
                    "on-click":  "cmd /c start ms-settings:network"
                },
    "power-profiles-daemon":  {
                                  "format":  "{icon}",
                                  "tooltip-format":  "当前性能模式：{profile}\n---\n左键：切换性能模式",
                                  "tooltip":  true,
                                  "format-icons":  {
                                                       "performance":  "󱐋",
                                                       "balanced":  "",
                                                       "power-saver":  ""
                                                   }
                              },
    "custom/screenshot":  {
                              "format":  "",
                              "tooltip-format":  "左键：区域截图\n中键：全屏截图\n右键：截图标注",
                              "on-click":  "cmd /c start ms-screenclip:"
                          },
    "group/audio":  {
                        "orientation":  "inherit",
                        "drawer":  {
                                       "transition-left-to-right":  false
                                   },
                        "modules":  [
                                        "pulseaudio",
                                        "pulseaudio/slider"
                                    ]
                    },
    "pulseaudio":  {
                       "tooltip-format":  "左键：静音\n右键：关闭麦克风\n中键：打开音频面板\n滚轮：调节音量",
                       "format":  "{icon} {format_source} ",
                       "format-bluetooth":  " {format_source} ",
                       "format-source":  "{volume}%",
                       "format-source-muted":  "",
                       "format-muted":  " {format_source} ",
                       "format-icons":  {
                                            "headphone":  "",
                                            "headset":  "",
                                            "bluetooth":  "",
                                            "speaker":  [
                                                            "",
                                                            "",
                                                            ""
                                                        ]
                                        }
                   },
    "pulseaudio/slider":  {
                              "min":  0,
                              "max":  100,
                              "orientation":  "horizontal"
                          },
    "custom/applauncher":  {
                               "tooltip-format":  "左键：打开启动器\n右键：打开控制中心",
                               "format":  "",
                               "on-click":  "explorer.exe",
                               "on-click-right":  "cmd /c start ms-settings:"
                           },
    "group/powermenu":  {
                            "orientation":  "inherit",
                            "drawer":  {
                                           "transition-left-to-right":  false
                                       },
                            "modules":  [
                                            "custom/wlogout"
                                        ]
                        },
    "custom/wlogout":  {
                           "tooltip-format":  "左键：呼出会话面板",
                           "format":  "󰐥",
                           "on-click":  "cmd /c start ms-settings:powersleep",
                           "on-scroll-up":  "true",
                           "on-scroll-down":  "true"
                       },
    "backlight/slider":  {
                             "min":  5,
                             "max":  100,
                             "orientation":  "horizontal"
                         },
    "backlight":  {
                      "tooltip":  true,
                      "tooltip-format":  "调节内屏亮度",
                      "format":  "{icon}",
                      "format-icons":  [
                                           "",
                                           "",
                                           "",
                                           "",
                                           "",
                                           "",
                                           "",
                                           "",
                                           ""
                                       ]
                  },
    "group/ddcutil":  {
                          "orientation":  "inherit",
                          "drawer":  {
                                         "transition-left-to-right":  false
                                     },
                          "modules":  [
                                          "backlight/slider",
                                          "backlight"
                                      ]
                      },
    "custom/swaync":  {
                          "tooltip":  false,
                          "format":  "󰂚",
                          "on-click":  "cmd /c start ms-settings:notifications"
                      },
    "idle_inhibitor":  {
                           "format":  "{icon}",
                           "format-icons":  {
                                                "activated":  "",
                                                "deactivated":  ""
                                            },
                           "start-activated":  true,
                           "tooltip-format-activated":  "自动熄屏已禁止",
                           "tooltip-format-deactivated":  "自动熄屏已开启"
                       },
    "custom/separator#1":  {
                               "format":  "󱋱",
                               "tooltip":  false
                           },
    "custom/clipboard":  {
                             "format":  "󰅍",
                             "on-click":  "cmd /c start ms-settings:clipboard",
                             "tooltip-format":  "左键：打开剪贴板历史\n右键：清除剪贴板历史"
                         },
    "custom/wallpapers":  {
                              "format":  "󰸉",
                              "tooltip-format":  "左键：打开壁纸面板\n右键：随机切换壁纸\n中键：下一张壁纸",
                              "on-click":  "cmd /c start ms-settings:personalization-background"
                          },
    "custom/actions":  {
                           "format":  "",
                           "tooltip-format":  "左键：打开 Kitty 终端\n右键：打开 Alacritty 终端",
                           "on-click":  "cmd /c start cmd.exe",
                           "on-click-right":  "cmd /c start powershell.exe"
                       },
    "custom/colors-theme":  {
                                "format":  "{}",
                                "return-type":  "json",
                                "exec":  "powershell -NoProfile -ExecutionPolicy Bypass -File \"%LOCALAPPDATA%\\Programs\\Waybar\\config\\scripts\\toggle-colors.ps1\" status",
                                "tooltip":  true,
                                "on-click":  "powershell -NoProfile -ExecutionPolicy Bypass -File \"%LOCALAPPDATA%\\Programs\\Waybar\\config\\scripts\\toggle-colors.ps1\" toggle"
                            },
    "sway/window":  {
                        "format":  "{title}",
                        "max-length":  40,
                        "tooltip-format":  "{title}\n{app_id}",
                        "rewrite":  {
                                        "(.*) - Mozilla Firefox":  "🌎 $1"
                                    }
                    }
}