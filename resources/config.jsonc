// Waybar for Windows 默认配置
//
// 语法与上游 Waybar 完全一致（JSONC：允许注释与尾逗号），可直接使用上游配置。
// 本文件只启用当前移植阶段已实现且跨平台语义一致的模块；其余模块的示例见注释。
{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 8,

    "modules-left": [
        "custom/hello"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/os",
        "custom/uptime"
    ],

    // ---------------------------------------------------------------- 模块
    "custom/hello": {
        "format": "Waybar Windows",
        "tooltip": false
    },
    "clock": {
        "format": "{:%H:%M:%S}",
        "tooltip-format": "{:%Y-%m-%d %A}"
    },
    "custom/os": {
        // 一次性输出：interval 省略时 exec 只执行一次
        "exec": "ver",
        "interval": 3600,
        "format": "{}",
        "tooltip": false
    },
    "custom/uptime": {
        "exec": "powershell -NoProfile -Command \"$t=(Get-Date)-(Get-CimInstance Win32_OperatingSystem).LastBootUpTime; '{0}h {1}m' -f [int]$t.TotalHours, $t.Minutes\"",
        "interval": 60,
        "format": "⏱ {}",
        "tooltip": false
    }
}
